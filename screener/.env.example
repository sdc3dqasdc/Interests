# Copy this file to .env and fill in your real Alpaca keys.
# .env is gitignored and will never be committed.
#
#   cp .env.example .env
#   # then edit .env with your Key ID and Secret
#
# Both short_term_screener_alpaca.py and backtest.py auto-load .env at startup,
# and PyCharm's EnvFile plugin can point the Run button at the same file.

ALPACA_API_KEY=PK_your_key_id_here
ALPACA_SECRET_KEY=your_secret_here
